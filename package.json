{
  "name": "@lbrdan/react-umami",
  "version": "0.0.1",
  "description": "Umami client for React, hooks only",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/react-umami.umd.cjs",
  "module": "./dist/react-umami.js",
  "types": "./dist/react-umami.d.ts",
  "sideEffects": false,
  "repository": "https://github.com/LBRDan/react-umami.git",
  "author": "Daniele Lubrano <lubrano.daniele@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^18.20.0 || >=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "exports": {
    ".": {
      "types": "./dist/react-umami.d.ts",
      "import": "./dist/react-umami.js",
      "require": "./dist/react-umami.umd.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest coverage"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0",
    "msw": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
