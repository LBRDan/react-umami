{
  "name": "@lbrdan/react-umami",
  "version": "0.0.1",
  "description": "Umami client for React, hooks only",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/react-umami.umd.cjs",
  "module": "./dist/react-umami.js",
  "types": "./dist/react-umami.d.ts",
  "sideEffects": false,
  "repository": "https://github.com/LBRDan/react-umami.git",
  "author": "Daniele Lubrano <lubrano.daniele@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": {
      "types": "./dist/react-umami.d.ts",
      "import": "./dist/react-umami.js",
      "require": "./dist/react-umami.umd.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest coverage"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "5.8.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
